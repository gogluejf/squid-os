        {
          "id": "tc1",
          "tool": "read_file",
          "path": "/a.go",
          "trace": "read",
          "is_ranged": false,
          "status": "success",
          "instruction_tokens": 10,
          "execution_tokens": 20
        },
        {
          "id": "tc2",
          "tool": "read_file",
          "path": "/a.go",
          "trace": "read",
          "is_ranged": false,
          "status": "success",
          "instruction_tokens": 10,
          "execution_tokens": 20
