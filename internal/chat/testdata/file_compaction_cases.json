{
  "description": "Shared fixture for file-context-compaction. Defines scenarios tested by both Go (internal/chat/compaction_test.go) and Python (chat-analytics/scripts/test_file_compaction.py). Each scenario specifies a sequence of file-tool events and the expected compaction outcome. Go and Python must produce identical compacted_events, retained_events, and token totals for every case.",
  "semantics": {
    "control": "Settings-only (context_compaction switch). No CLI or agent override.",
    "compaction": "Dynamic, non-destructive. Never mutates persisted history.",
    "replacement": "Fixed internal text. Superseded reads keep path/range args with result replaced. Superseded edits replace old_string, new_string, and result. Superseded writes/creates replace content and result.",
    "ranged_read": "Partial observation, never a checkpoint. Distinguished by start_line/end_line in instruction arguments (Go) or is_ranged flag (fixture).",
    "checkpoint": "Full read (no range), write_file trace=write, write_file trace=create. Supersedes all earlier successful events for the same path.",
    "edit": "Delta, never a checkpoint. No-op edit (trace=read) is still a delta.",
    "failure": "Failed operations are always retained, never compacted.",
    "analytics": "Always computes current next-request projection regardless of enabled switch. Setting controls outgoing snapshot only.",
    "out_of_scope": [
      "bash result compaction",
      "sed parsing",
      "structured search",
      "glob/find tooling",
      "per-turn metrics",
      "persisted compaction decisions"
    ]
  },
  "cases": [
