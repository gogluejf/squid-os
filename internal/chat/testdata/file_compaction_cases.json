      "expected": {
        "compacted_events": 2,
        "retained_events": 1,
        "compacted_instruction_tokens": 20,
        "compacted_execution_tokens": 40,
        "compacted_tokens": 60,
        "retained_instruction_tokens": 10,
        "retained_execution_tokens": 20,
        "retained_tokens": 30
